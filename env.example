# =============================================================
#  AI Lab Manual & Experiment Generator — Environment Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the .env file — it is listed in .gitignore.
# =============================================================

# ── IBM Cloud / watsonx.ai Credentials (REQUIRED) ────────────────────────────
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_CLOUD_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── IBM Granite Model IDs ─────────────────────────────────────────────────────
GRANITE_LLM_MODEL_ID=ibm/granite-4-h-small
GRANITE_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# ── IBM Cloud Object Storage (optional — for large corpora) ──────────────────
IBM_COS_API_KEY=your_cos_api_key_here
IBM_COS_INSTANCE_CRN=your_cos_instance_crn_here
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET_NAME=lab-manual-corpus

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=lab_curriculum

# ── Flask Application ─────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_SECRET_KEY=change-this-to-a-random-secret-in-production
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# ── RAG Configuration ─────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.65

# ── Generation Parameters ─────────────────────────────────────────────────────
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TOP_K=50
LLM_REPETITION_PENALTY=1.1

# ── Data Directories ──────────────────────────────────────────────────────────
DATA_DIR=./data
CORPUS_DIR=./data/corpus
OUTPUT_DIR=./data/output
UPLOADS_DIR=./data/uploads
